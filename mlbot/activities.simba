(*
# Activities
Concrete skill training implementations for the ML bot.
Each activity knows how to perform a single skill-training loop iteration,
including level-appropriate method selection, banking, and error handling.

Activities are self-contained: they read the game state, decide on the
appropriate training method for the current level, execute it, and return.
*)

{$DEFINE ML_ACTIVITIES_INCLUDED}
{$IFNDEF ML_ENGINE_INCLUDED}
  {$I WaspLib/mlbot/ml_engine.simba}
{$ENDIF}

type
  (*
  ## EActivityResult
  Outcome of a single activity execution cycle.
  *)
  EActivityResult = enum(
    SUCCESS,          // Action completed normally
    NEED_BANK,        // Inventory full or need supplies
    NEED_MOVE,        // Not in the right location
    STUCK,            // Could not perform action
    LEVEL_UP,         // Leveled up during action
    INTERRUPTED,      // Unexpected interface or state
    DIED              // Player died
  );

  (*
  ## TSkillMethod
  Describes a specific training method within a skill (e.g., "Oak trees" for WC).
  *)
  TSkillMethod = record
    Name: String;
    MinLevel: Integer;
    MaxLevel: Integer;       // Level at which to move on (-1 = never)
    XPPerAction: Integer;    // Approximate XP gained per action
    RequiredItems: TRSItemArray;
    Chunk: ERSChunk;         // Map area for this method
  end;

  TSkillMethodArray = array of TSkillMethod;

  (*
  ## TActivity
  Represents a trainable activity with level-aware method progression.
  *)
  TActivity = record
    Name: String;
    Action: EMLAction;
    Skill: ERSSkill;
    Methods: TSkillMethodArray;
    CurrentMethodIdx: Integer;
    TotalActions: UInt64;
    TotalXPGained: UInt64;
    IsEnabled: Boolean;
  end;

  TActivityArray = array of TActivity;

(*
## BuildWoodcuttingMethods
Returns the progression of woodcutting training methods by level.
*)
function BuildWoodcuttingMethods(): TSkillMethodArray;
begin
  Result += TSkillMethod([
    'Regular trees', 1, 15, 25, [], ERSChunk.LUMBRIDGE
  ]);
  Result += TSkillMethod([
    'Oak trees', 15, 30, 37, [], ERSChunk.VARROCK
  ]);
  Result += TSkillMethod([
    'Willow trees', 30, 45, 67, [], ERSChunk.DRAYNOR_VILLAGE
  ]);
  Result += TSkillMethod([
    'Maple trees', 45, 60, 100, [], ERSChunk.SEERS_VILLAGE
  ]);
  Result += TSkillMethod([
    'Yew trees', 60, 75, 175, [], ERSChunk.VARROCK
  ]);
  Result += TSkillMethod([
    'Magic trees', 75, 99, 250, [], ERSChunk.SEERS_VILLAGE
  ]);
end;

