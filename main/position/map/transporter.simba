

{$DEFINE WL_TRANSPORTER_INCLUDED}
{$INCLUDE_ONCE WaspLib/main.simba}

{%anchor WL_DEBUG_TRANSPORTER}
{.$DEFINE WL_DEBUG_TRANSPORTER}

type
  ESpellTeleport = enum(
    HOUSE_INSIDE,
    HOUSE_OUTSIDE,
    KOUREND,
    LASSAR,
    OURANIA,
    RESPAWN,
    VARROCK,
    GRAND_EXCHANGE,
    CAMELOT,
    SEERS,
    KHAZARD,
    FALADOR,
    BARROWS,
    MOONCLAN,
    CEMETERY,
    GHORROCK,
    ARDOUGNE,
    PADDEWWA,
    KHARYRLL,
    ANNAKARL,
    CATHERBY,
    APE_ATOLL_DUNGEON,
    LUMBRIDGE,
    BARBARIAN,
    APE_ATOLL,
    TROLLHEIM,
    MIND_ALTAR,
    WATCHTOWER,
    YANILLE,
    ICE_PLATEU,
    LUNAR_HOME,
    FENKENSTRAINS_CASTLE,
    SALVE_GRAVEYARD,
    ARCEUUS_LIBRARY,
    HARMONY_ISLAND,
    EDGEVILLE_HOME,
    DRAYNOR_MANOR,
    FISHING_GUILD,
    LUMBRIDGE_HOME,
    WEST_ARDOUGNE,
    CARRALLANGAR,
    ARCEUUS_HOME,
    WATERBIRTH,
    SENNTISTEN
  );

  EItemTeleport = enum(
    DUELING_RING, GAMES_NECKLACE, DIGSITE_PENDANT, MYSTIC_CAPE
  );

const
  // Simba-AI fork (FORK.md, #41): each landing is the dest tile of the
  // spell's row in Skretzo's shortest-path (teleportation_spells.tsv and
  // teleportation_spells_home.tsv @ 8551e60), in Map.Position's frame:
  // the tile's corner x*4, (12607-y)*4, plus RSTranslator.MapWidth of X
  // per plane (APE_ATOLL and WATCHTOWER land off plane 0). WATCHTOWER and
  // LUNAR_HOME hold the tile a cast landed on, not the source's (FORK.md
  // 23, Simba-AI #392). HOUSE_INSIDE, HOUSE_OUTSIDE and RESPAWN stay
  // empty: they land where the account's house or respawn point is.
  TELEPORT_COORDINATES: array [ESpellTeleport] of TPoint = [
    [], //HOUSE_INSIDE
    [], //HOUSE_OUTSIDE
    [6564, 35736], //KOUREND
    [12016, 36548], //LASSAR
    [9872, 37444], //OURANIA
    [], //RESPAWN
    [12852, 36732], //VARROCK
    [12660, 36512], //GRAND EXCHANGE
    [11028, 36512], //CAMELOT
    [10904, 36480], //SEERS
    [10544, 37760], //KHAZARD
    [11856, 36916], //FALADOR
    [14256, 37168], //BARROWS
    [8452, 34768], //MOONCLAN
    [11924, 35380], //CEMETERY
    [11904, 34928], //GHORROCK
    [10648, 37208], //ARDOUGNE
    [12388, 10904], //PADDEWWA
    [13976, 36536], //KHARYRLL
    [13152, 34876], //ANNAKARL
    [11204, 36632], //CATHERBY
    [11084, 14020], //APE_ATOLL_DUNGEON
    [12884, 37556], //LUMBRIDGE
    [10172, 36152], //BARBARIAN
    [36788, 39236], //APE_ATOLL
    [11560, 35712], //TROLLHEIM
    [11916, 36388], //MIND_ALTAR
    [61388, 37984], //WATCHTOWER
    [10336, 38040], //YANILLE
    [11900, 34676], //ICE_PLATEU
    [8372, 34776], //LUNAR_HOME
    [14192, 36312], //FENKENSTRAINS_CASTLE
    [13732, 36592], //SALVE_GRAVEYARD
    [6528, 35080], //ARCEUUS_LIBRARY
    [15188, 38964], //HARMONY_ISLAND
    [12348, 36412], //EDGEVILLE_HOME
    [12436, 37024], //DRAYNOR_MANOR
    [10452, 36864], //FISHING_GUILD
    [12884, 37556], //LUMBRIDGE_HOME
    [10000, 37268], //WEST_ARDOUGNE
    [12632, 35764], //CARRALLANGAR
    [6800, 34900], //ARCEUUS_HOME
    [10184, 35408], //WATERBIRTH
    [13280, 37080] //SENNTISTEN
  ];

type

  TTransporter = record
    HomeTeleportTimer: TCountDown;
  end;

function TTransporter.Teleport(spell: ESpellTeleport; pos: TWalkerPositionFunction = nil): Boolean;
var
  t: UInt64;
  option: String;
  magicSpell: ESpell;
  hasTimer: Boolean;
begin
  if pos = nil then
    pos := @Map.Position;

  case spell of
    ESpellTeleport.LUMBRIDGE_HOME, ESpellTeleport.EDGEVILLE_HOME,
    ESpellTeleport.LUNAR_HOME, ESpellTeleport.ARCEUUS_HOME:
    begin
      t := 22*TICK;
      hasTimer := True;
    end;
    else t := 6*TICK;
  end;

  case spell of
    ESpellTeleport.HOUSE_INSIDE, ESpellTeleport.HOUSE_OUTSIDE:
      magicSpell := ESpell.TELEPORT_TO_HOUSE;
    ESpellTeleport.KOUREND: magicSpell := ESpell.TELEPORT_TO_KOUREND;
    ESpellTeleport.LASSAR: magicSpell := ESpell.LASSAR_TELEPORT;
    ESpellTeleport.OURANIA: magicSpell := ESpell.OURANIA_TELEPORT;
    ESpellTeleport.RESPAWN: magicSpell := ESpell.RESPAWN_TELEPORT;
    ESpellTeleport.VARROCK, ESpellTeleport.GRAND_EXCHANGE:
      magicSpell := ESpell.VARROCK_TELEPORT;
    ESpellTeleport.CAMELOT, ESpellTeleport.SEERS:
      magicSpell := ESpell.CAMELOT_TELEPORT;
    ESpellTeleport.KHAZARD: magicSpell := ESpell.KHAZARD_TELEPORT;
    ESpellTeleport.FALADOR: magicSpell := ESpell.FALADOR_TELEPORT;
    ESpellTeleport.BARROWS: magicSpell := ESpell.BARROWS_TELEPORT;
    ESpellTeleport.MOONCLAN: magicSpell := ESpell.MOONCLAN_TELEPORT;
    ESpellTeleport.CEMETERY: magicSpell := ESpell.CEMETERY_TELEPORT;
    ESpellTeleport.GHORROCK: magicSpell := ESpell.GHORROCK_TELEPORT;
    ESpellTeleport.ARDOUGNE: magicSpell := ESpell.ARDOUGNE_TELEPORT;
    ESpellTeleport.PADDEWWA: magicSpell := ESpell.PADDEWWA_TELEPORT;
    ESpellTeleport.KHARYRLL: magicSpell := ESpell.KHARYRLL_TELEPORT;
    ESpellTeleport.ANNAKARL: magicSpell := ESpell.ANNAKARL_TELEPORT;
    ESpellTeleport.CATHERBY: magicSpell := ESpell.CATHERBY_TELEPORT;
    ESpellTeleport.APE_ATOLL_DUNGEON:
      magicSpell := ESpell.APE_ATOLL_DUNGEON_TELEPORT;
    ESpellTeleport.LUMBRIDGE: magicSpell := ESpell.LUMBRIDGE_TELEPORT;
    ESpellTeleport.BARBARIAN: magicSpell := ESpell.BARBARIAN_TELEPORT;
    ESpellTeleport.APE_ATOLL: magicSpell := ESpell.APE_ATOLL_TELEPORT;
    ESpellTeleport.TROLLHEIM: magicSpell := ESpell.TROLLHEIM_TELEPORT;
    ESpellTeleport.MIND_ALTAR: magicSpell := ESpell.MIND_ALTAR_TELEPORT;
    ESpellTeleport.WATCHTOWER, ESpellTeleport.YANILLE:
      magicSpell := ESpell.WATCHTOWER_TELEPORT;
    ESpellTeleport.ICE_PLATEU: magicSpell := ESpell.ICE_PLATEU_TELEPORT;
    ESpellTeleport.LUNAR_HOME: magicSpell := ESpell.LUNAR_HOME_TELEPORT;
    ESpellTeleport.FENKENSTRAINS_CASTLE:
      magicSpell := ESpell.FENKENSTRAINS_CASTLE_TELEPORT;
    ESpellTeleport.SALVE_GRAVEYARD:
      magicSpell := ESpell.SALVE_GRAVEYARD_TELEPORT;
    ESpellTeleport.ARCEUUS_LIBRARY:
      magicSpell := ESpell.ARCEUUS_LIBRARY_TELEPORT;
    ESpellTeleport.HARMONY_ISLAND:
      magicSpell := ESpell.HARMONY_ISLAND_TELEPORT;
    ESpellTeleport.EDGEVILLE_HOME:
      magicSpell := ESpell.EDGEVILLE_HOME_TELEPORT;
    ESpellTeleport.DRAYNOR_MANOR: magicSpell := ESpell.DRAYNOR_MANOR_TELEPORT;
    ESpellTeleport.FISHING_GUILD: magicSpell := ESpell.FISHING_GUILD_TELEPORT;
    ESpellTeleport.LUMBRIDGE_HOME:
      magicSpell := ESpell.LUMBRIDGE_HOME_TELEPORT;
    ESpellTeleport.WEST_ARDOUGNE: magicSpell := ESpell.WEST_ARDOUGNE_TELEPORT;
    ESpellTeleport.CARRALLANGAR: magicSpell := ESpell.CARRALLANGAR_TELEPORT;
    ESpellTeleport.ARCEUUS_HOME: magicSpell := ESpell.ARCEUUS_HOME_TELEPORT;
    ESpellTeleport.WATERBIRTH: magicSpell := ESpell.WATERBIRTH_TELEPORT;
    ESpellTeleport.SENNTISTEN: magicSpell := ESpell.SENNTISTEN_TELEPORT;
  end;

  case spell of
    ESpellTeleport.HOUSE_OUTSIDE: option:= 'Outside';
    ESpellTeleport.GRAND_EXCHANGE: option:= 'Grand Exchange';
    ESpellTeleport.SEERS: option:= 'Seers';
    ESpellTeleport.YANILLE: option:= 'Yanille';
    else option:= 'Cast';
  end;

  if Magic.Cast(magicSpell, option) then
    if SleepUntil(pos().InRange(TELEPORT_COORDINATES[spell], 30), 300, t) then
    begin
      Biometrics.Sleep(0, 4*TICK);
      Exit(True);
    end;
end;

{$H-}
var

  Transporter: TTransporter;
{$H+}
