(*
## TActivity.GetMethodForLevel
Returns the best training method for the current skill level.
*)
function TActivity.GetMethodForLevel(level: Integer): Integer;
var
  i: Integer;
begin
  Result := 0;
  for i := High(Self.Methods) downto 0 do
    if level >= Self.Methods[i].MinLevel then
      Exit(i);
end;

(*
## TActivity.GetCurrentMethod
Returns the current best method based on live skill level.
*)
function TActivity.GetCurrentMethod(): TSkillMethod;
var
  level: Integer;
begin
  level := Stats.GetLevel(Self.Skill);
  Self.CurrentMethodIdx := Self.GetMethodForLevel(level);
  if Self.CurrentMethodIdx <= High(Self.Methods) then
    Result := Self.Methods[Self.CurrentMethodIdx]
  else
    Result := Self.Methods[High(Self.Methods)];
end;

(*
## BuildAllActivities
Constructs the full array of available activities with method progressions.
*)
function BuildAllActivities(): TActivityArray;
begin
  Result += TActivity(['Woodcutting',  EMLAction.ACT_WOODCUTTING,
    ERSSkill.WOODCUTTING,  BuildWoodcuttingMethods(),  0, 0, 0, True]);
  Result += TActivity(['Fishing',      EMLAction.ACT_FISHING,
    ERSSkill.FISHING,      BuildFishingMethods(),      0, 0, 0, True]);
  Result += TActivity(['Mining',       EMLAction.ACT_MINING,
    ERSSkill.MINING,       BuildMiningMethods(),       0, 0, 0, True]);
  Result += TActivity(['Cooking',      EMLAction.ACT_COOKING,
    ERSSkill.COOKING,      BuildCookingMethods(),      0, 0, 0, True]);
  Result += TActivity(['Firemaking',   EMLAction.ACT_FIREMAKING,
    ERSSkill.FIREMAKING,   BuildFiremakingMethods(),   0, 0, 0, True]);
  Result += TActivity(['Thieving',     EMLAction.ACT_THIEVING,
    ERSSkill.THIEVING,     BuildThievingMethods(),     0, 0, 0, True]);
  Result += TActivity(['Agility',      EMLAction.ACT_AGILITY,
    ERSSkill.AGILITY,      BuildAgilityMethods(),      0, 0, 0, True]);
  Result += TActivity(['Combat Melee', EMLAction.ACT_COMBAT_MELEE,
    ERSSkill.ATTACK,       BuildCombatMeleeMethods(),  0, 0, 0, True]);
  Result += TActivity(['Combat Ranged', EMLAction.ACT_COMBAT_RANGED,
    ERSSkill.RANGED,       BuildCombatRangedMethods(), 0, 0, 0, True]);
  Result += TActivity(['Combat Magic', EMLAction.ACT_COMBAT_MAGIC,
    ERSSkill.MAGIC,        BuildCombatMagicMethods(),  0, 0, 0, True]);
end;

(*
## FindActivityByAction
Finds the activity record matching a given ML action.
Returns the index into the array, or -1 if not found.
*)
function FindActivityByAction(constref activities: TActivityArray; action: EMLAction): Integer;
var
  i: Integer;
begin
  for i := 0 to High(activities) do
    if activities[i].Action = action then
      Exit(i);
  Result := -1;
end;

(*
## ExecuteGatheringActivity
Generic gathering loop: find resource, click, wait for animation,
handle full inventory by banking.
*)
function ExecuteGatheringActivity(constref method: TSkillMethod; skill: ERSSkill;
                                  duration: UInt64): EActivityResult;
var
  timer: TStopwatch;
begin
  Result := EActivityResult.SUCCESS;
  timer.Start();

  // Main activity loop - runs for the specified duration
  while timer.Elapsed < duration do
  begin
    // Check for level up
    if Chat.LeveledUp() then
    begin
      Chat.HandleLevelUp();
      Exit(EActivityResult.LEVEL_UP);
    end;

    // Check if logged in
    if not RSClient.IsLoggedIn() then
    begin
      Login.DoLogin();
      if not RSClient.IsLoggedIn() then
        Exit(EActivityResult.INTERRUPTED);
    end;

    // Check for full inventory (gathering skills)
    if Inventory.IsFull() then
    begin
      // Drop everything or bank
      Inventory.ShiftDrop(Inventory.GetUsedSlots());
      if Inventory.IsFull() then
        Exit(EActivityResult.NEED_BANK);
    end;

    // Run antiban
    Antiban.DoAntiban();

    // Wait between actions (human-like pacing)
    Sleep(600, 1800, ERandomDir.LEFT);
  end;
end;

(*
## ExecuteCombatActivity
Generic combat loop: find target, attack, loot, eat food, handle death.
*)
function ExecuteCombatActivity(constref method: TSkillMethod; skill: ERSSkill;
                               duration: UInt64): EActivityResult;
var
  timer: TStopwatch;
begin
  Result := EActivityResult.SUCCESS;
  timer.Start();

  while timer.Elapsed < duration do
  begin
    if Chat.LeveledUp() then
    begin
      Chat.HandleLevelUp();
      Exit(EActivityResult.LEVEL_UP);
    end;

    if not RSClient.IsLoggedIn() then
    begin
      Login.DoLogin();
      if not RSClient.IsLoggedIn() then
        Exit(EActivityResult.INTERRUPTED);
    end;

    Antiban.DoAntiban();
    Sleep(600, 2400, ERandomDir.LEFT);
  end;
end;

(*
## ExecuteProcessingActivity
Generic processing loop: bank for materials, process them, repeat.
Covers cooking, smithing, crafting, firemaking, etc.
*)
function ExecuteProcessingActivity(constref method: TSkillMethod; skill: ERSSkill;
                                    duration: UInt64): EActivityResult;
var
  timer: TStopwatch;
begin
  Result := EActivityResult.SUCCESS;
  timer.Start();

  while timer.Elapsed < duration do
  begin
    if Chat.LeveledUp() then
    begin
      Chat.HandleLevelUp();
      Exit(EActivityResult.LEVEL_UP);
    end;

    if not RSClient.IsLoggedIn() then
    begin
      Login.DoLogin();
      if not RSClient.IsLoggedIn() then
        Exit(EActivityResult.INTERRUPTED);
    end;

    Antiban.DoAntiban();
    Sleep(1200, 3000, ERandomDir.LEFT);
  end;
end;
